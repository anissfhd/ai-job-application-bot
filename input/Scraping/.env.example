# Copie ce fichier en « .env » (dans ce même dossier) et colle tes clés Apify.
# Copy this file to ".env" (in this same folder) and paste your Apify API tokens.
# Apify Console -> Settings -> API & Integrations -> Personal API tokens.
# Les clés sont essayées dans l'ordre : si l'une est refusée (plus de crédit…), le robot passe à la suivante.
APIFY_TOKEN=
APIFY_TOKEN_2=
APIFY_TOKEN_3=
APIFY_TOKEN_4=
APIFY_TOKEN_5=
APIFY_TOKEN_6=
APIFY_TOKEN_7=
APIFY_TOKEN_8=
APIFY_TOKEN_9=
APIFY_TOKEN_10=

# Normalise text files; keep Windows line endings where Windows needs them
# (also applies to the "Download ZIP" archive built by GitHub).
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.xlsx binary

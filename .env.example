# Copie ce fichier en « .env » et remplis les clés.
# Les valeurs du .env sont prioritaires sur config/config.yaml.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
SMTP_PASSWORD=

# Mot de passe UNIQUE utilisé par le robot pour créer / réinitialiser tes comptes candidat
# sur les sites des entreprises (jamais écrit dans les logs : le LLM ne voit que {MOT_DE_PASSE}).
MOT_DE_PASSE_SITES=
# Versions de SECOURS, différentes et plus longues (créées par FORMULAIRE.bat, section 7) :
# le robot passe à la 2e si un site refuse la 1re (trop courte, pas assez complexe…), puis à la 3e.
MOT_DE_PASSE_SITES_2=
MOT_DE_PASSE_SITES_3=

# TEST CAPTCHA (outil isolé scripts/test_captcha.py — pour TON PROPRE SITE uniquement)
# Clé API 2Captcha : https://2captcha.com/settings/api  (page « API » de ton compte)
TWOCAPTCHA_API_KEY=
